---
import BaseLayout from '../../layouts/BaseLayout.astro'
import content from '../../content/en.json'

import Navbar from '../../components/molecules/Navbar.astro'
import HeroSection from '../../components/organisms/HeroSection.astro'
import AiCapabilities from '../../components/organisms/AiCapabilities.astro'
import WhyPrivate from '../../components/organisms/WhyPrivate.astro'
import ManagementTools from '../../components/organisms/ManagementTools.astro'
import ArchitectureSection from '../../components/organisms/ArchitectureSection.astro'
import IntegrationsSection from '../../components/organisms/IntegrationsSection.astro'
import DeploymentSection from '../../components/organisms/DeploymentSection.astro'
import SecuritySection from '../../components/organisms/SecuritySection.astro'
import BenchmarksSection from '../../components/organisms/BenchmarksSection.astro'
import AudienceSection from '../../components/organisms/AudienceSection.astro'
import DisclaimerSection from '../../components/organisms/DisclaimerSection.astro'
import DemoSection from '../../components/organisms/DemoSection.astro'
import FooterSection from '../../components/organisms/FooterSection.astro'

const title = 'Pragma — Private Clinical Intelligence for Healthcare Centers in Latin America'
const description = 'Clinical chatbot, medical image analysis, and differential diagnosis. 100% on-premise, open source.'
const currentLang = 'en'
const siteUrl = Astro.url.origin

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Pragma",
      url: siteUrl,
      description,
      inLanguage: "en",
      about: {
        "@type": "Thing",
        name: "Private Clinical Intelligence",
        description: "On-premise medical AI platform for healthcare centers in Latin America"
      },
      keywords: ["clinical intelligence", "medical AI", "clinical chatbot", "image analysis", "differential diagnosis", "on-premise", "open source", "healthcare", "Latin America"],
      applicationCategory: "MedicalSoftware",
      audience: {
        "@type": "Audience",
        audienceType: "Healthcare centers, clinics, hospitals, specialist networks, diagnostic imaging centers"
      }
    },
    {
      "@type": "SoftwareApplication",
      name: "Pragma",
      description,
      url: siteUrl,
      applicationCategory: "MedicalSoftware",
      operatingSystem: "Linux",
      offers: {
        "@type": "Offer",
        price: "3000",
        priceCurrency: "USD",
        priceValidUntil: "2027-12-31",
        availability: "https://schema.org/InStock"
      },
      author: {
        "@type": "Organization",
        name: "Pragma",
        url: siteUrl,
        address: { "@type": "PostalAddress", addressCountry: "AR", addressLocality: "Oberá", addressRegion: "Misiones" }
      },
      featureList: [
        "Clinical chatbot with evidence and automatic citations",
        "Medical image analysis (X-rays, CT scans, MRIs)",
        "Medical literature processing",
        "Differential diagnosis based on symptoms",
        "100% on-premise on your infrastructure",
        "Auditable open source",
        "TLS 1.3 encryption, LUKS2, Keycloak SSO",
        "CIS production-level hardening"
      ],
      memoryRequirements: "RTX 4090 or higher, 64GB RAM recommended",
      softwareVersion: "0.1.0",
      countryOfOrigin: "AR"
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: siteUrl,
      inLanguage: "en",
      isPartOf: { "@type": "WebSite", name: "Pragma", url: siteUrl },
      about: {
        "@type": "Thing",
        name: "Private Clinical Intelligence",
        description: "Pragma builds private, auditable, sovereign medical software infrastructure for healthcare centers in LATAM, starting from Oberá, Misiones, Argentina."
      }
    }
  ]
}
---

<BaseLayout {title} {description} lang={currentLang} {jsonLd}>
  <Navbar content={content.nav} lang={currentLang} />
  <HeroSection content={content.hero} />
  <AiCapabilities content={content.ai} />
  <WhyPrivate content={content.whyPrivate} />
  <ManagementTools content={content.management} />
  <ArchitectureSection content={content.architecture} />
  <IntegrationsSection content={content.integrations} />
  <DeploymentSection content={content.deployment} />
  <SecuritySection content={content.security} />
  <BenchmarksSection content={content.benchmarks} />
  <AudienceSection content={content.audience} />
  <DisclaimerSection content={content.disclaimer} />
  <DemoSection content={content.demo} />
  <FooterSection content={content.footer} />
</BaseLayout>
