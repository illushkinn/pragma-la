---
import '../tokens.css'
import '../styles/brand.css'
import '../styles/components.css'
import Seo from '../components/Seo.astro'

export interface Props {
  title: string
  description: string
  ogImage?: string
  lang?: string
  jsonLd?: Record<string, unknown>
}

const { title, description, ogImage = '/og-image.svg', lang = 'es', jsonLd } = Astro.props
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#00003A" />

    <Seo {title} {description} lang={lang} image={ogImage} {jsonLd} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@800&display=swap" rel="stylesheet" />
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,700,401&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/png" href="/images/pragma_png3.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <main id="main-content">
      <slot />
    </main>
    <script>
      (function() {
        var theme = localStorage.getItem('pragma-theme');
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </body>
</html>
