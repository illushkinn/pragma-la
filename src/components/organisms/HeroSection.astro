---
import Illustration from '../atoms/Illustration.astro'
import Badge from '../atoms/Badge.astro'

export interface Props {
  content: any
}

const { content } = Astro.props
---

<section id="que-es" class="section section-hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <div class="cer-item cer-item--1"><Badge>{content.badge}</Badge></div>
      <h1 class="hero-h1 cer-item cer-item--2">
        <span class="hero-maintext">{content.title1}</span>
        <span class="hero-maintext">{content.title2}</span>
      </h1>
      <p class="hero-description cer-item cer-item--3">{content.description}</p>
      <div class="hero-ctas cer-item cer-item--4">
        <a href="#demo" class="btn btn-primary">{content.ctaPrimary}</a>
        <a href="#arquitectura" class="btn btn-outline">{content.ctaSecondary}</a>
      </div>
    </div>
    <div class="hero-image">
      <Illustration name="hero" alt="Pragma AI dashboard" class="hero-img" width={600} height={400} loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>
