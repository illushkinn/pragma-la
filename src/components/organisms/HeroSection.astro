---
import Badge from '../atoms/Badge.astro'

export interface Props {
  content: any
}

const { content } = Astro.props
---

<section class="section section-hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <Badge>{content.badge}</Badge>
      <h1 class="hero-h1 hero-h1--es">{content.title1}<br /><span class="hero-highlight">{content.title2}</span></h1>
      <p class="hero-description">{content.description}</p>
      <div class="hero-ctas">
        <a href="#demo" class="btn btn-primary">{content.ctaPrimary}</a>
        <a href="#arquitectura" class="btn btn-glass">{content.ctaSecondary}</a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/images/pragma_png1.png" alt="Pragma AI dashboard" class="hero-img" />
    </div>
  </div>
</section>
