---
import SectionTitle from '../atoms/SectionTitle.astro'

interface Capability {
  title: string
  desc: string
  iconSrc: string
}

interface Step {
  number: string
  title: string
  text: string
}

export interface Props {
  content: {
    title: string
    subtitle: string
    capabilities: Capability[]
    howItWorksTitle: string
    steps: Step[]
  }
}

const { content } = Astro.props
const [chatbot, imaging, literature, dxDiff] = content.capabilities
const steps = content.steps
---

<section id="ai" class="section">
  <div class="container">
    <SectionTitle title={content.title} subtitle={content.subtitle} />

    <!-- Bento Grid -->
    <div class="bento-grid">
      <!-- Chatbot → prominent (2 rows) -->
      <article class="bento-item bento-item--chatbot glass-card card-pad-lg">
        <img src={chatbot.iconSrc} alt={chatbot.title} width="144" height="144" class="capability-icon" />
        <h3 class="capability-title">{chatbot.title}</h3>
        <p class="capability-desc">{chatbot.desc}</p>
      </article>

      <!-- Diagnóstico Diferencial -->
      <article class="bento-item bento-item--dx solid-card card-pad-lg">
        <img src={dxDiff.iconSrc} alt={dxDiff.title} width="144" height="144" class="capability-icon" />
        <h3 class="capability-title">{dxDiff.title}</h3>
        <p class="capability-desc">{dxDiff.desc}</p>
      </article>

      <!-- Análisis de Imágenes -->
      <article class="bento-item bento-item--imaging solid-card card-pad-lg">
        <img src={imaging.iconSrc} alt={imaging.title} width="144" height="144" class="capability-icon" />
        <h3 class="capability-title">{imaging.title}</h3>
        <p class="capability-desc">{imaging.desc}</p>
      </article>

      <!-- Procesamiento de Literatura → full width -->
      <article class="bento-item bento-item--lit solid-card card-pad-lg">
        <img src={literature.iconSrc} alt={literature.title} width="144" height="144" class="capability-icon" />
        <h3 class="capability-title">{literature.title}</h3>
        <p class="capability-desc">{literature.desc}</p>
      </article>
    </div>

    <!-- Steps Flow (vertical) -->
    <div class="steps-flow">
      {steps.map((step: Step) => (
        <div class="step-card">
          <span class="step-number">{step.number}</span>
          <div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-text">{step.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
