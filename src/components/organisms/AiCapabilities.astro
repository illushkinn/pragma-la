---
import Illustration from '../atoms/Illustration.astro'
import SectionTitle from '../atoms/SectionTitle.astro'
import CapabilityCard from '../molecules/CapabilityCard.astro'
import StepCard from '../molecules/StepCard.astro'

export interface Props {
  content: any
}

const { content } = Astro.props
---

<section id="ai" class="section">
  <div class="container">
    <SectionTitle title={content.title} subtitle={content.subtitle} />
    <div class="capability-grid">
      {content.capabilities.map((cap: any) => (
        <CapabilityCard title={cap.title} desc={cap.desc} iconSrc={cap.iconSrc} />
      ))}
    </div>
  </div>
</section>

<section class="section section-steps">
  <div class="container">
    <SectionTitle title={content.howItWorksTitle} subtitle={content.howItWorksSubtitle} />
    <div class="steps-container">
      <div class="steps-list">
        {content.steps.map((step: any) => (
          <StepCard number={step.number} title={step.title} text={step.text} />
        ))}
      </div>
      <div class="steps-image">
        <Illustration name="workflow" alt="Pragma workflow" class="section-img" width={600} height={400} />
      </div>
    </div>
  </div>
</section>
