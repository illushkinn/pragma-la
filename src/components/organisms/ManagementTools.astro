---
import Illustration from '../atoms/Illustration.astro'
import SectionTitle from '../atoms/SectionTitle.astro'
import FeatureCard from '../molecules/FeatureCard.astro'

export interface Props {
  content: any
}

const { content } = Astro.props
---

<section id="gestion" class="section">
  <div class="container">
    <SectionTitle title={content.title} subtitle={content.subtitle} />
    <div class="management-grid">
      <div class="management-cards">
        {content.features.map((feature: any) => (
          <FeatureCard title={feature.title} desc={feature.desc} />
        ))}
      </div>
      <div class="management-image">
        <Illustration name="dashboard" alt="Practice management" class="section-img" width={600} height={400} />
      </div>
    </div>
  </div>
</section>
