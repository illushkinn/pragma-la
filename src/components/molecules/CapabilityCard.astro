---
export interface Props {
  title: string
  desc: string
  iconSrc: string
}

const { title, desc, iconSrc } = Astro.props
---

<div class="capability-card glass-card card-pad-xl card-align-center">
  <img src={iconSrc} alt={title} class="capability-icon" />
  <h3 class="capability-title">{title}</h3>
  <p class="capability-desc">{desc}</p>
</div>
