---
export interface Props {
  name: string
  range: string
  desc: string
  gpu: string
}

const { name, range, desc, gpu } = Astro.props
---

<div class="pricing-card solid-card card-pad-lg card-align-center">
  <p class="pricing-name">{name}</p>
  <p class="pricing-range">{range}</p>
  <p class="pricing-desc">{desc}</p>
  <p class="pricing-gpu">{gpu}</p>
</div>
