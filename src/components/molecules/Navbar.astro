---
export interface Props {
  content: any
  lang: string
}

const { content, lang } = Astro.props
---

<nav class="navbar" aria-label="Navegación principal">
  <div class="nav-row">
    <a href="/" class="isologo" aria-label="Pragma">
      <img src="/images/pragma_png2_dark-mode.png" alt="Pragma" class="isologo-mark" />
    </a>
    <div class="nav-right">
      <div class="lang-toggle">
        {
          lang === 'es' ? (
            <>
              <span class="lang-btn active">{content.langEs}</span>
              <a href="/en/" class="lang-btn">{content.langEn}</a>
            </>
          ) : (
            <>
              <a href="/" class="lang-btn">{content.langEs}</a>
              <span class="lang-btn active">{content.langEn}</span>
            </>
          )
        }
      </div>
    </div>
  </div>
  <div class="nav-links">
    <a href="#que-es" class="nav-link">{content.queEs}</a>
    <a href="#ai" class="nav-link">{content.ai}</a>
    <a href="#gestion" class="nav-link">{content.gestion}</a>
  </div>
</nav>
