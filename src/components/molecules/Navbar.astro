---
export interface Props {
  content: any
  lang: string
}

const { content, lang } = Astro.props
---

<nav class="navbar">
  <img src="/images/pragma_png2.png" alt="Pragma" class="nav-logo nav-logo-dark" />
  <img src="/images/pragma_logo.png" alt="Pragma" class="nav-logo nav-logo-light" />
  <div class="nav-links">
    <a href="#que-es" class="nav-link">{content.queEs}</a>
    <a href="#ai" class="nav-link">{content.ai}</a>
    <a href="#gestion" class="nav-link">{content.gestion}</a>
    <div class="lang-toggle">
      {
        lang === 'es' ? (
          <>
            <span class="lang-btn active">{content.langEs}</span>
            <a href="/en/" class="lang-btn">{content.langEn}</a>
          </>
        ) : (
          <>
            <a href="/" class="lang-btn">{content.langEs}</a>
            <span class="lang-btn active">{content.langEn}</span>
          </>
        )
      }
    </div>
    <button class="theme-toggle" onclick="window.__toggleTheme()" aria-label="Toggle theme">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <a href="#demo" class="btn btn-primary" style="padding:var(--space-sm) var(--space-lg);font-size:0.9rem;text-decoration:none;">{content.demo}</a>
  </div>
</nav>
